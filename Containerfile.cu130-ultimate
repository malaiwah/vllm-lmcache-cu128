FROM docker.io/voipmonitor/vllm:dev-cu130

USER root

ENV PATH=/opt/venv/bin:/root/.local/bin:$PATH \
    PIP_NO_CACHE_DIR=1 \
    PYTHONUNBUFFERED=1 \
    SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0+cu130ultimate \
    LD_LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib:/usr/local/cuda/lib64:/opt/venv/lib/python3.12/site-packages/torch/lib:$LD_LIBRARY_PATH

WORKDIR /workspace

# Minimal toolchain for rebuilding LMCache against the CUDA 13 vLLM image.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git \
      build-essential \
      pkg-config \
      python3-dev \
      ninja-build \
      cmake \
      libcusparse-dev-13-0 \
      libcublas-dev-13-0 \
      libcusolver-dev-13-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pr37443_latest_runtime_patch.py /tmp/pr37443_latest_runtime_patch.py
COPY pr_lmcache_api_fix.py /tmp/pr_lmcache_api_fix.py
COPY config/start-lmcache-cu130.sh /usr/local/bin/start-lmcache-cu130.sh
COPY config/lmcache.yaml /config/lmcache.yaml

RUN python3 /tmp/pr37443_latest_runtime_patch.py && \
    python3 -m pip install --no-cache-dir --upgrade pip wheel "setuptools==79.0.0" && \
    python3 -m pip uninstall -y lmcache cupy-cuda12x nixl nixl-cu12 nixl-cu13 || true && \
    git clone --depth=1 https://github.com/LMCache/LMCache.git /tmp/LMCache && \
    python3 -c 'from pathlib import Path; src = Path("/tmp/LMCache/requirements/common.txt").read_text().splitlines(); skip = ("nixl", "cupy-cuda12x", "torch", "transformers", "numpy", "numba"); filtered = [line for line in src if not line.strip().startswith(skip)]; Path("/tmp/lmcache-common-cu13.txt").write_text("\n".join(filtered) + "\n")' && \
    python3 -m pip install --no-cache-dir -r /tmp/LMCache/requirements/build.txt && \
    python3 -m pip install --no-cache-dir "numpy==2.2.2" "numba==0.61.2" "llvmlite==0.44.0" && \
    python3 -m pip install --no-cache-dir tabulate cuda-tile && \
    python3 -m pip install --no-cache-dir -r /tmp/lmcache-common-cu13.txt && \
    python3 -m pip install --no-cache-dir cupy-cuda13x && \
    python3 -m pip install --no-cache-dir --no-deps nixl-cu13 && \
    TORCH_CUDA_ARCH_LIST="${TORCH_CUDA_ARCH_LIST:-12.0a}" \
      python3 -m pip install --no-cache-dir --no-build-isolation --no-deps /tmp/LMCache && \
    python3 /tmp/pr_lmcache_api_fix.py && \
    chmod +x /usr/local/bin/start-lmcache-cu130.sh && \
    python3 -c 'import importlib; mods = ["torch", "vllm", "lmcache", "lmcache.integration.vllm.vllm_v1_adapter"]; [print(name, getattr(importlib.import_module(name), "__file__", "<builtin>")) for name in mods]'

ENTRYPOINT ["/usr/local/bin/start-lmcache-cu130.sh"]
